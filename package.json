{
  "name": "buildtrack",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:browser": "node tests/browser/inquiry-form.ts && node tests/browser/home-demo-ui.ts",
    "test:browser:academic-demo": "node tests/browser/academic-demo.ts",
    "test:worker": "node tests/worker/quotation-intake.ts",
    "test:worker:owner": "node tests/worker/quotation-owner.ts",
    "test:worker:e2e": "node tests/worker/quotation-e2e.ts",
    "test:build:turnstile": "node tests/worker/turnstile-build.ts",
    "test:deploy:templates": "node tests/worker/deploy-templates.ts",
    "walkthrough:quotation": "node tests/worker/quotation-walkthrough.ts",
    "check:published-build": "node scripts/compare-published-build.ts",
    "check:release": "node scripts/check-release.ts"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
