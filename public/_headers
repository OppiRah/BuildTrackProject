# Response headers for Cloudflare Workers static assets (docs/ARCHITECTURE.md §7).
# Copied into dist/ by the build; Cloudflare applies it and does not serve it.
# Everything else keeps Cloudflare's default "public, max-age=0, must-revalidate" + ETag.

# Astro's build files are content-hashed, so a changed file always gets a new name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# strict-origin-when-cross-origin keeps the origin in the Referer sent to Formspree,
# which its optional "Restrict to Domain" setting relies on.
# Academic demo of the quotation workflow: browser-only by design. The page may not fetch or submit
# anything anywhere (connect-src/form-action 'none'), so it cannot reach a server, Formspree or any
# email service, and it cannot be framed.
/academic-demo/*
  Content-Security-Policy: connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'
  Cache-Control: no-store

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
