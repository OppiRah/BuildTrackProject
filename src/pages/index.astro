---
import { contactHref } from '../lib/contact-links.ts';
import Icon from '../components/site/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { customerSegments } from '../config/business.ts';
import { plans, priceBasis, priceLabel, pricingNote, tierLabels } from '../config/pricing.ts';
import { pageMeta, primaryCta } from '../config/site.ts';

const meta = pageMeta('/');
const quotationHref = contactHref({ type: 'quotation' });

// Capability showcase (scroll-driven on desktop, stacked otherwise). Each image is a screen
// captured from the Interactive Platform Demo (fictional fixtures); each link opens that section.
const capabilities: { id: string; label: string; title: string; text: string; image: string; alt: string; caption: string; href: string; linkText: string }[] = [
  {
    id: 'materials',
    label: 'Materials',
    title: 'Inventory, movements and low stock',
    text: 'Stock on hand, usage against the planned quantity and reorder levels for every site, with low stock flagged early.',
    image: '/media/demo/demo-inventory.webp',
    alt: 'Materials section of the demo, marked Simulated data, with the Low stock only filter on: usage bars for four low-stock sample materials such as deformed bar and gravel.',
    caption: 'Materials, “Low stock only” filter on. Fictional sample data.',
    href: '/product-demo/#demo-panel-inventory',
    linkText: 'Open Materials in the demo',
  },
  {
    id: 'equipment',
    label: 'Equipment',
    title: 'Assignments, utilization and maintenance',
    text: 'Where each tagged unit is assigned, how much it worked in the last seven days, and which units are idle or under maintenance.',
    image: '/media/demo/demo-equipment.webp',
    alt: 'Equipment section of the demo, marked Simulated data: seven-day utilization bars for sample units with their status, such as a tower crane active at 90% and a dump truck under maintenance.',
    caption: 'Equipment utilization and status. Fictional sample data.',
    href: '/product-demo/#demo-panel-equipment',
    linkText: 'Open Equipment in the demo',
  },
  {
    id: 'deliveries',
    label: 'Deliveries',
    title: 'Delivery status and recorded receipts',
    text: 'Scheduled, in-transit, delayed and delivered loads for each project, with the time each delivery was recorded as received.',
    image: '/media/demo/demo-deliveries.webp',
    alt: 'Deliveries section of the demo, marked Simulated data: counts by status and a table of sample deliveries, one recorded as delivered at a stated time and one delayed.',
    caption: 'Deliveries by status. Fictional sample data.',
    href: '/product-demo/#demo-panel-deliveries',
    linkText: 'Open Deliveries in the demo',
  },
  {
    id: 'reporting',
    label: 'Reporting',
    title: 'Project summaries and comparisons',
    text: 'Low-stock, utilization and delivery figures for one project or all of them, with planned and actual progress side by side.',
    image: '/media/demo/demo-overview.webp',
    alt: 'Overview section of the demo, marked Simulated data: summary figures for all sample projects and the start of planned-versus-actual project progress and alerts.',
    caption: 'Overview for all sample projects. Fictional sample data.',
    href: '/product-demo/#demo-panel-overview',
    linkText: 'Open the Overview in the demo',
  },
];

// Three steps, each led by an illustrative stock photo (crops recorded in
// design/home-visual-samples/CROPS.json). The section lead states what is simulated.
const steps: { title: string; text: string; image: string; width: number; height: number }[] = [
  {
    title: 'Record site activity',
    text: 'Log material movements and equipment activity.',
    image: '/media/home/step-record-site-activity.webp',
    width: 800,
    height: 600,
  },
  {
    title: 'Monitor resources',
    text: 'See stock levels, equipment status and deliveries.',
    image: '/media/home/step-monitor-resources.webp',
    width: 720,
    height: 540,
  },
  {
    title: 'Review project information',
    text: 'Spot issues and plan the next action.',
    image: '/media/home/step-review-project-information.webp',
    width: 800,
    height: 600,
  },
];

// "Who we serve": one illustrative photo per approved segment (equal size and treatment).
// Tilt, swing and drift only shape the desktop collage (src/scripts/collage.ts).
const audienceImages: Record<(typeof customerSegments)[number]['id'], string> = {
  'construction-companies': '/media/home/audience-construction-companies.webp',
  contractors: '/media/home/audience-contractors.webp',
  'project-managers': '/media/home/audience-project-managers.webp',
  'engineering-firms': '/media/home/audience-engineering-firms.webp',
  'government-projects': '/media/home/audience-government-projects.webp',
  'real-estate-developers': '/media/home/audience-real-estate-developers.webp',
  'equipment-rental': '/media/home/audience-equipment-rental.webp',
};
const collageMotion = [
  { tilt: -5, swing: 4, dx: -8, dy: 12 },
  { tilt: 3, swing: -3, dx: 6, dy: -10 },
  { tilt: -2, swing: 5, dx: -6, dy: 14 },
  { tilt: 5, swing: -4, dx: 8, dy: -12 },
  { tilt: -4, swing: 3, dx: -6, dy: 10 },
  { tilt: 2, swing: -5, dx: 6, dy: -14 },
  { tilt: -3, swing: 4, dx: -8, dy: 12 },
];
---

<BaseLayout title={meta.title} description={meta.description}>
  <script is:inline>
    document.documentElement.classList.add('entrance-run');
  </script>
  <section class="hero on-dark" aria-labelledby="hero-heading">
    <div class="hero-media" data-hero-media data-video-src="/media/construction-hero-candidate.mp4">
      <picture>
        <source
          type="image/webp"
          srcset="/media/construction-hero-640.webp 640w, /media/construction-hero-1280.webp 1280w"
          sizes="100vw"
        />
        <img src="/media/construction-hero-poster.jpg" width="1280" height="720" alt="" fetchpriority="high" decoding="async" />
      </picture>
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-label">Academic business prototype</p>
        <h1 id="hero-heading">Know your materials. Track your equipment. Keep projects moving.</h1>
        <p class="hero-lead">
          Explore BuildTrack’s proposed approach to construction resource management—from inventory and equipment to
          deliveries and project reporting.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/product-demo/">Explore the Demo</a>
          <a class="button button-secondary" href={quotationHref}>Request a Quotation</a>
        </div>
      </div>
      <div class="hero-foot">
        <p class="media-credit">Background: stock construction footage, not a BuildTrack project.</p>
        <button type="button" class="video-toggle" data-video-toggle hidden>
          <svg class="icon-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path>
          </svg>
          <svg class="icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.5v13l10.5-6.5z"></path>
          </svg>
          <span data-video-label>Play background video</span>
        </button>
      </div>
    </div>
  </section>

  <section class="section showcase on-dark" aria-labelledby="showcase-heading">
    <div class="container showcase-grid">
      <div class="showcase-copy stack" data-reveal>
        <p class="eyebrow">Interactive Platform Demo</p>
        <h2 id="showcase-heading">See the proposed dashboard on any screen</h2>
        <p class="lead">
          These screens come from BuildTrack’s own Interactive Platform Demo, which runs in your browser on four fictional
          sample projects.
        </p>
        <p>The phone shows this website on a small screen. BuildTrack has no native mobile app.</p>
        <p><a class="button button-primary" href="/product-demo/">Explore the Demo</a></p>
      </div>
      <figure class="devices" data-reveal="devices">
        <p class="sim-label">Simulated platform demo</p>
        <div class="device-stage">
          <div class="laptop">
            <div class="laptop-screen">
              <img
                src="/media/demo/demo-laptop.webp"
                width="1280"
                height="800"
                loading="lazy"
                decoding="async"
                alt="The Interactive Platform Demo on a laptop: a navy sidebar with its six sections and a light Overview workspace with the project picker, Reset, a Simulated data label and low-stock, utilization and delivery figures."
              />
            </div>
            <div class="laptop-base"></div>
          </div>
          <div class="phone">
            <img
              src="/media/demo/demo-phone.webp"
              width="440"
              height="952"
              loading="lazy"
              decoding="async"
              alt="The demo in this website on a phone-sized screen: a Sections button, project picker and Reset above the Simulated data label and Overview figures."
            />
          </div>
        </div>
        <figcaption>Screens captured from the Interactive Platform Demo. All projects and figures are fictional.</figcaption>
      </figure>
    </div>
  </section>

  <section class="capabilities" id="capabilities" aria-labelledby="capabilities-heading" data-scrolly>
    <div class="scrolly-sticky" data-scrolly-sticky>
      <div class="scrolly-content" data-scrolly-content>
        <div class="container scrolly-head">
          <header class="section-intro stack" data-reveal>
            <p class="eyebrow">Capabilities</p>
            <h2 id="capabilities-heading">Four things BuildTrack proposes to keep track of</h2>
            <p class="lead">Each panel shows a screen from the simulated demo and opens that part of it.</p>
          </header>
          <p class="scrolly-more">
            <a class="text-link" href="/solutions/">Explore all solutions and services <Icon name="arrow" size={20} /></a>
          </p>
        </div>
        <div class="scrolly-viewport" data-scrolly-viewport>
          <ol class="scrolly-track" data-scrolly-track>
            {
              capabilities.map((item, index) => (
                <li class="scrolly-panel" id={`capability-${item.id}`}>
                  <figure class="panel-media">
                    <img src={item.image} width="1088" height="816" loading="lazy" decoding="async" alt={item.alt} />
                    <figcaption>{item.caption}</figcaption>
                  </figure>
                  <div class="panel-body">
                    <p class="panel-label">
                      <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span> {item.label}
                    </p>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                    <a class="text-link" href={item.href}>
                      {item.linkText} <Icon name="arrow" size={20} />
                    </a>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section workflow on-dark" aria-labelledby="workflow-heading">
    <div class="container">
      <header class="section-intro stack" data-reveal>
        <p class="eyebrow">How it would work</p>
        <h2 id="workflow-heading">Three steps from site to decision</h2>
        <p class="lead">
          The demo simulates the recording and reporting steps with fictional data. No QR, RFID or IoT hardware is
          connected; hardware integration is a proposed concept.
        </p>
      </header>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step" data-reveal style={`--i: ${index}`}>
              <img
                class="step-media"
                src={step.image}
                width={step.width}
                height={step.height}
                loading="lazy"
                decoding="async"
                alt=""
              />
              <h3>
                <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="visually-hidden">Step {index + 1}: </span>
                {step.title}
              </h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="workflow-foot" data-reveal>
        <p class="media-credit">Photos: illustrative stock photography, not BuildTrack projects, customers or working hardware.</p>
        <p><a class="text-link" href="/how-it-works/">How it works <Icon name="arrow" size={20} /></a></p>
      </div>
    </div>
  </section>

  <section class="section segments" aria-labelledby="segments-heading" data-collage>
    <div class="container">
      <header class="section-intro stack" data-reveal>
        <p class="eyebrow">Who we serve</p>
        <h2 id="segments-heading">Built for everyone who manages construction resources</h2>      </header>
      <div class="collage-layout">
        <ul class="audience-list" data-collage-stage>
          {
            customerSegments.map((segment, index) => {
              const motion = collageMotion[index]!;
              return (
                <li
                  class="audience"
                  data-audience={segment.id}
                  style={`--tilt: ${motion.tilt}deg; --swing: ${motion.swing}deg; --dx: ${motion.dx}px; --dy: ${motion.dy}px`}
                >
                  <div class="audience-media">
                    <img src={audienceImages[segment.id]} width="400" height="500" loading="lazy" decoding="async" alt="" />
                  </div>
                  <div class="audience-text">
                    <h3 data-audience-label>{segment.label}</h3>
                    <p data-audience-need>{segment.need}</p>
                  </div>
                  <button type="button" class="audience-select" data-audience-select aria-pressed="false" hidden>
                    <span class="audience-hint">
                      View details<span class="visually-hidden">: {segment.label}</span>
                      <Icon name="arrow" size={16} />
                    </span>
                  </button>
                </li>
              );
            })
          }
        </ul>
        <div class="audience-detail" data-collage-detail aria-live="polite" hidden>
          <p class="audience-detail-label" data-detail-label></p>
          <p class="audience-detail-text" data-detail-text>Select a photo to read what BuildTrack would offer that group.</p>
        </div>
      </div>
      <p class="media-credit segments-credit">Photos: illustrative stock photography, not BuildTrack customers or projects.</p>
    </div>
  </section>

  <section class="section pricing-preview" aria-labelledby="pricing-heading">
    <div class="container">
      <header class="section-intro stack" data-reveal>
        <p class="eyebrow">Pricing</p>
        <h2 id="pricing-heading">Three proposed packages</h2>
        <p class="lead">{pricingNote}</p>
      </header>
      <ul class="price-list" data-reveal>
        {
          plans.map((plan) => (
            <li>
              <p class="tier">{tierLabels[plan.tier]}</p>
              <h3>{plan.name}</h3>
              <p class="price">
                {priceLabel(plan)}
                {plan.amountPhp !== null && <span class="basis">{priceBasis}</span>}
              </p>
              <p class="positioning">{plan.positioning}</p>
              <a class="text-link" href={contactHref({ type: 'service', plan: plan.id })}>
                Avail {plan.name} <Icon name="arrow" size={20} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="after"><a class="text-link" href="/pricing/">See pricing details <Icon name="arrow" size={20} /></a></p>
    </div>
  </section>

  <section class="closing on-dark" aria-labelledby="closing-heading">
    <picture class="closing-media">
      <img src="/media/construction-wide-1280.webp" width="1280" height="853" alt="" loading="lazy" decoding="async" />
    </picture>
    <div class="container closing-inner stack" data-reveal>
      <h2 id="closing-heading">Ready to see BuildTrack?</h2>
      <p class="lead">Request a walkthrough of the proposed platform or a quotation for your project.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={primaryCta.href}>{primaryCta.label}</a>
        <a class="button button-secondary" href={quotationHref}>Request a Quotation</a>
      </div>
      <p class="media-credit">Background: stock construction photo, not a BuildTrack project.</p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initHeroVideo } from '../scripts/hero-video.ts';
  import { initReveal } from '../scripts/reveal.ts';
  import { initScrolly } from '../scripts/scrolly.ts';
  import { initCollage } from '../scripts/collage.ts';
  initReveal();
  initHeroVideo();
  initScrolly();
  initCollage();
</script>

<style>
  /* ---- Hero ---------------------------------------------------------------- */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: min(85vh, 46rem);
    overflow: hidden;
    background: var(--color-ink);
    color: #fff;
  }

  .hero-media,
  .hero-media img,
  .hero-media :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-media {
    z-index: -1;
  }

  .hero-media :global(video) {
    opacity: 0;
    transition: opacity 600ms ease-out;
  }

  .hero-media:global(.is-playing) :global(video) {
    opacity: 1;
  }

  /* Text sits on at least 86% ink (UX_BRAND §2.2); the right side shows more footage on wide screens. */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(7 26 43 / 0.86);
  }

  @media (min-width: 64rem) {
    .hero-media::after {
      background: linear-gradient(
        90deg,
        rgb(7 26 43 / 0.92) 0%,
        rgb(7 26 43 / 0.86) 72%,
        rgb(7 26 43 / 0.5) 100%
      );
    }
  }

  .hero-inner {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-8);
    padding-block: var(--space-10) var(--space-5);
  }

  @media (min-width: 64rem) {
    .hero-inner {
      padding-block: var(--space-12) var(--space-6);
    }
  }

  /* Grid and flex children may shrink below their longest word, so enlarged text wraps. */
  .hero-inner > *,
  .scrolly-head > * {
    min-width: 0;
  }

  .hero-copy {
    align-self: center;
    max-width: 44rem;
  }

  .hero-copy > * + * {
    margin-top: var(--space-5);
  }

  .hero-label {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-yellow);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-yellow);
  }

  .hero h1 {
    font-size: clamp(2.25rem, 1.4rem + 4vw, 4.25rem);
    letter-spacing: -0.02em;
  }

  .hero-lead {
    font-size: var(--text-lg);
    color: var(--color-blue-pale);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .media-credit {
    font-size: var(--text-sm);
    color: var(--color-blue-pale);
  }

  .video-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgb(234 246 255 / 0.7);
    border-radius: 999px;
    background: rgb(7 26 43 / 0.7);
    color: #fff;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--duration-fast);
  }

  .video-toggle:hover {
    background: rgb(7 26 43 / 0.95);
  }

  .video-toggle[hidden] {
    display: none;
  }

  .video-toggle[aria-disabled='true'] {
    cursor: default;
    opacity: 0.85;
  }

  .video-toggle .icon-pause,
  .video-toggle[data-state='playing'] .icon-play,
  .video-toggle[data-state='unavailable'] svg {
    display: none;
  }

  .video-toggle[data-state='playing'] .icon-pause {
    display: block;
  }

  /* Staggered entrance, complete in under a second. Runs only with JavaScript (html.entrance-run is
     set by an inline script before the hero renders), never under reduced motion, and never twice:
     src/scripts/reveal.ts sets html.entrance-done once it has finished or been cancelled. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.entrance-run:not(.entrance-done)) .hero-copy > * {
      animation: hero-in 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .hero-copy > :nth-child(2) {
      animation-delay: 80ms;
    }

    .hero-copy > :nth-child(3) {
      animation-delay: 160ms;
    }

    .hero-copy > :nth-child(4) {
      animation-delay: 240ms;
    }

    /* Focus never waits for the entrance. */
    .hero-copy > :focus-within {
      animation: none;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  /* ---- Section reveals (src/scripts/reveal.ts) ------------------------------- */
  :global(.reveal-ready [data-reveal]) {
    transition:
      opacity 500ms ease-out,
      transform 500ms ease-out;
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  :global(.reveal-ready [data-reveal]:not(.is-revealed, [data-reveal='devices'])) {
    opacity: 0;
    transform: translateY(20px);
  }

  :global(.reveal-instant),
  :global(.reveal-instant *) {
    transition: none !important;
  }

  @media print {
    :global([data-reveal] *),
    :global([data-reveal]) {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* ---- Showcase -------------------------------------------------------------- */
  .showcase {
    background: var(--color-navy);
    color: #fff;
    overflow: hidden;
  }

  .showcase .lead,
  .workflow .lead,
  .closing .lead {
    color: var(--color-blue-pale);
  }

  .showcase-grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .showcase-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-10);
    }
  }

  .showcase-grid > * {
    min-width: 0;
  }

  .sim-label {
    display: inline-block;
    margin-bottom: var(--space-4);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-yellow);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-yellow);
  }

  /* Room on the right and below for the overlapping phone. */
  .device-stage {
    position: relative;
    padding: 0 14% 7% 0;
  }

  .laptop-screen {
    margin-inline: 5%;
    padding: clamp(5px, 1vw, 10px);
    border-radius: 14px 14px 0 0;
    background: #1e293b;
    box-shadow: 0 24px 48px rgb(0 0 0 / 0.35);
  }

  .laptop-screen img,
  .phone img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .laptop-base {
    position: relative;
    height: clamp(10px, 1.6vw, 18px);
    border-radius: 0 0 14px 14px;
    background: linear-gradient(#e2e8f0, #94a3b8);
  }

  .laptop-base::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 16%;
    height: 40%;
    border-radius: 0 0 8px 8px;
    background: #64748b;
    transform: translateX(-50%);
  }

  .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 25%;
    min-width: 5.5rem;
    padding: clamp(4px, 0.8vw, 7px);
    border-radius: clamp(14px, 2.4vw, 26px);
    background: #1e293b;
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.45);
  }

  .phone img {
    border-radius: clamp(10px, 1.8vw, 20px);
  }

  .devices figcaption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-blue-pale);
  }

  /* Laptop enters, then the phone; both then stay still. */
  :global(.reveal-ready) .devices:not(:global(.is-revealed)) .laptop,
