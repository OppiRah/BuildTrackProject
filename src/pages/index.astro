---
import { contactHref, quotationJourneyHref } from '../lib/contact-links.ts';
import Icon from '../components/site/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { customerSegments } from '../config/business.ts';
import { plans, priceBasis, priceLabel, pricingNote, tierLabels } from '../config/pricing.ts';
import { pageMeta, primaryCta } from '../config/site.ts';

const meta = pageMeta('/');
const quotationHref = quotationJourneyHref();

// Capability showcase (scroll-driven on desktop, stacked otherwise). Each image is a screen
// captured from the Interactive Platform Demo (fictional fixtures); each link opens that section.
const capabilities: { id: string; label: string; title: string; text: string; image: string; alt: string; caption: string; href: string; linkText: string }[] = [
  {
    id: 'materials',
    label: 'Materials',
    title: 'Inventory, movements and low stock',
    text: 'Stock on hand, usage against the planned quantity and reorder levels for every site, with low stock flagged early.',
    image: '/media/demo/demo-inventory.webp',
    alt: 'Materials section of the demo, marked Simulated data, with the Low stock only filter on: usage bars for four low-stock sample materials such as deformed bar and gravel.',
    caption: 'Materials, “Low stock only” filter on. Fictional sample data.',
    href: '/product-demo/#demo-panel-inventory',
    linkText: 'Open Materials in the demo',
  },
  {
    id: 'equipment',
    label: 'Equipment',
    title: 'Assignments, utilization and maintenance',
    text: 'Where each tagged unit is assigned, how much it worked in the last seven days, and which units are idle or under maintenance.',
    image: '/media/demo/demo-equipment.webp',
    alt: 'Equipment section of the demo, marked Simulated data: seven-day utilization bars for sample units with their status, such as a tower crane active at 90% and a concrete pump idle at 10%.',
    caption: 'Equipment utilization and status. Fictional sample data.',
    href: '/product-demo/#demo-panel-equipment',
    linkText: 'Open Equipment in the demo',
  },
  {
    id: 'deliveries',
    label: 'Deliveries',
    title: 'Delivery status and recorded receipts',
    text: 'Scheduled, in-transit, delayed and delivered loads for each project, with the time each delivery was recorded as received.',
    image: '/media/demo/demo-deliveries.webp',
    alt: 'Deliveries section of the demo, marked Simulated data: counts by status and a table of sample deliveries, one recorded as delivered at a stated time and one delayed.',
    caption: 'Deliveries by status. Fictional sample data.',
    href: '/product-demo/#demo-panel-deliveries',
    linkText: 'Open Deliveries in the demo',
  },
  {
    id: 'reporting',
    label: 'Reporting',
    title: 'Project summaries and comparisons',
    text: 'Low-stock, utilization and delivery figures for one project or all of them, with planned and actual progress side by side.',
    image: '/media/demo/demo-overview.webp',
    alt: 'Overview section of the demo, marked Simulated data: summary figures for all sample projects and the start of planned-versus-actual project progress and alerts.',
    caption: 'Overview for all sample projects. Fictional sample data.',
    href: '/product-demo/#demo-panel-overview',
    linkText: 'Open the Overview in the demo',
  },
];

// Illustrative layout drawings, one per capability, in the screenshots' 1088x816 space: outlines of
// the demo page's own regions, measured from each screenshot (title and project picker, the
// simulated-data notice, filters or summary cards, then that section's bars or table). Not data
// and not a device. Each drawing is split into horizontal bands that tile the screenshot from top
// to bottom; in the enhanced layout the outlines draw in one after another, and each band of the
// screenshot is revealed gradually as its outlines resolve, while they fade
// (src/scripts/capability-stage.ts).
type Band = { y0: number; y1: number; strokes: string[] };
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}h${w}v${h}h${-w}z`;
const line = (x1: number, y: number, x2: number) => `M${x1} ${y}H${x2}`;
/** A panel continuing past the bottom of the screenshot: sides and top edge only. */
const openBox = (x: number, y: number, w: number) => `M${x} 816V${y}H${x + w}V816`;
const pageHeader = (titleEnd: number): Band => ({
  y0: 0,
  y1: 116,
  strokes: [line(18, 74, titleEnd), line(688, 29, 740), box(688, 46, 281, 46), box(983, 42, 87, 52), line(16, 110, 1072)],
});
/** The workspace introduction and disclosure: heading, sentence, Simulated data badge, two disclosure
 * lines and the status line (whose length depends on the section). */
const intro = (statusEnd: number): Band => ({
  y0: 116,
  y1: 310,
  strokes: [line(18, 135, 263), line(18, 161, 963), box(16, 185, 163, 34), line(18, 237, 1045), line(18, 262, 603), line(18, 295, statusEnd)],
});
/** Bar chart rows: a label line and the bar's track. */
const barRows = (rows: number, labelY: number) =>
  Array.from({ length: rows }, (_, i) => [line(18, labelY + i * 56.5, 430), box(17, labelY + 17 + i * 56.5, 1054, 11)]).flat();
const drawings: Record<string, Band[]> = {
  materials: [
    pageHeader(158),
    intro(399),
    { y0: 310, y1: 490, strokes: [line(18, 334, 771), line(18, 364, 184), line(18, 408, 84), box(17, 424, 380, 48), box(423, 436, 22, 22), line(453, 447, 562)] },
    { y0: 490, y1: 780, strokes: [line(18, 512, 457), ...barRows(4, 562)] },
    { y0: 780, y1: 816, strokes: [openBox(17, 794, 1054)] },
  ],
  equipment: [
    pageHeader(181),
    intro(461),
    { y0: 310, y1: 490, strokes: [line(18, 334, 745), line(18, 364, 371), line(18, 408, 63), box(17, 424, 380, 48)] },
    { y0: 490, y1: 816, strokes: [line(18, 512, 293), ...barRows(5, 562)] },
  ],
  deliveries: [
    pageHeader(165),
    intro(415),
    {
      y0: 310,
      y1: 535,
      strokes: [line(18, 334, 767), line(18, 379, 63), box(17, 394, 380, 48), box(18, 468, 163, 51), box(190, 468, 148, 51), box(347, 468, 153, 51), box(509, 468, 139, 51)],
    },
    { y0: 535, y1: 816, strokes: [openBox(17, 545, 1054), line(36, 574, 179), box(17, 605, 1054, 48), line(17, 767, 1071)] },
  ],
  reporting: [
    pageHeader(160),
    intro(311),
    {
      y0: 310,
      y1: 625,
      strokes: [
        line(18, 334, 747), line(18, 364, 88),
        box(17, 403, 341, 167), box(373, 403, 342, 167), box(729, 403, 342, 167), line(45, 436, 192), line(400, 436, 639), line(756, 436, 895),
        line(18, 596, 458),
      ],
    },
    {
      y0: 625,
      y1: 816,
      strokes: [
        line(17, 658, 517), line(18, 699, 188), line(18, 744, 493), box(17, 792, 500, 10), box(17, 806, 500, 10),
        line(570, 658, 1071), line(570, 699, 642), line(570, 757, 647), line(570, 790, 1058),
      ],
    },
  ],
};
// Pacing within each capability's share of the scroll (fractions of that segment; the script sets
// the progress as --t). Outlines draw one after another in reading order between DRAW_START and
// DRAW_END, each over STROKE_SPAN, so about four are in progress at once. Each band's screenshot
// region is revealed from just before its first outline completes until REVEAL_END - DRAW_END after
// its last one does, so the last band finishes at REVEAL_END and the finished screen holds for the
// rest of the segment (about 40% drawing, overlapping reveal to 75%, 25% hold).
const DRAW_START = 0.03;
const DRAW_END = 0.43;
const STROKE_SPAN = 0.07;
const REVEAL_LEAD = 0.02;
const REVEAL_END = 0.75;
const pacing = (bands: Band[]) => {
  const total = bands.reduce((sum, band) => sum + band.strokes.length, 0);
  const step = (DRAW_END - DRAW_START - STROKE_SPAN) / (total - 1);
  let i = 0;
  return bands.map((band) => {
    const starts = band.strokes.map(() => DRAW_START + i++ * step);
    return { starts, reveal: [starts[0]! + STROKE_SPAN - REVEAL_LEAD, starts.at(-1)! + STROKE_SPAN + REVEAL_END - DRAW_END] };
  });
};
/** Each band's reveal window as "start,end;start,end;..." for the script (data-cap-windows: its own
 * attribute, never the entrance reveals' [data-reveal], whose 500 ms transition would smooth and
 * delay every scroll-driven change). */
const revealWindows = (bands: Band[]) => pacing(bands).map(({ reveal }) => reveal.map((x) => x.toFixed(4)).join(',')).join(';');

/** The screenshot's reveal mask in the enhanced layout: one full layer (shown once every band is
 * revealed, so the finished screen is exact) and one layer per band, each a soft top-to-bottom
 * sweep driven by that band's reveal progress (--r0, --r1, ...). Custom properties, so the static
 * layout (which never uses them) always shows the whole screenshot. */
const revealMask = (bands: Band[]) => {
  const layers = ['linear-gradient(rgb(0 0 0 / var(--done, 0)), rgb(0 0 0 / var(--done, 0)))'];
  const sizes = ['100% 100%'];
  const positions = ['0 0'];
  bands.forEach((band, k) => {
    const height = band.y1 - band.y0;
    layers.push(`linear-gradient(#000 calc(var(--r${k}, 0) * 140% - 40%), transparent calc(var(--r${k}, 0) * 140%))`);
    sizes.push(`100% ${((height / 816) * 100).toFixed(3)}%`);
    positions.push(`0 ${height === 816 ? 0 : ((band.y0 / (816 - height)) * 100).toFixed(3)}%`);
  });
  return `--cap-mask: ${layers.join(', ')}; --cap-mask-size: ${sizes.join(', ')}; --cap-mask-position: ${positions.join(', ')}`;
};

// Three steps, each led by an illustrative stock photo (crops recorded in
// design/home-visual-samples/CROPS.json). The section lead states what is simulated.
const steps: { title: string; text: string; image: string; width: number; height: number; target: string }[] = [
  {
    title: 'Record site activity',
    target: 'capture-events',
    text: 'Log material movements and equipment activity.',
    image: '/media/home/step-record-site-activity.webp',
    width: 800,
    height: 600,
  },
  {
    title: 'Monitor resources',
    target: 'cloud-platform',
    text: 'See stock levels, equipment status and deliveries.',
    image: '/media/home/step-monitor-resources.webp',
    width: 720,
    height: 540,
  },
  {
    title: 'Review project information',
    target: 'dashboards-decisions',
    text: 'Spot issues and plan the next action.',
    image: '/media/home/step-review-project-information.webp',
    width: 800,
    height: 600,
  },
];

// Full-frame posters from candidates approved for local playback review. Sources/licences and the
// retained original candidate set: design/media-source/AUDIENCE_VIDEO_PROPOSAL.json.
const audienceImages: Record<(typeof customerSegments)[number]['id'], { src: string; width: number; height: number }> = {
  'construction-companies': { src: '/media/home/candidate-construction-companies.webp', width: 960, height: 540 },
  contractors: { src: '/media/home/candidate-contractors.webp', width: 540, height: 960 },
  'project-managers': { src: '/media/home/candidate-project-managers.webp', width: 960, height: 540 },
  'engineering-firms': { src: '/media/home/candidate-engineering-firms.webp', width: 960, height: 540 },
  'government-projects': { src: '/media/home/candidate-government-projects.webp', width: 960, height: 540 },
  'real-estate-developers': { src: '/media/home/candidate-real-estate-developers.webp', width: 960, height: 540 },
  'equipment-rental': { src: '/media/home/candidate-equipment-rental.webp', width: 960, height: 540 },
};
---

<BaseLayout title={meta.title} description={meta.description}>
  <script is:inline>
    document.documentElement.classList.add('entrance-run');
  </script>
  <section class="hero on-dark" aria-labelledby="hero-heading">
    <div class="hero-media" data-hero-media data-video-src="/media/construction-hero-candidate.mp4">
      <picture>
        <source
          type="image/webp"
          srcset="/media/construction-hero-640.webp 640w, /media/construction-hero-1280.webp 1280w"
          sizes="100vw"
        />
        <img src="/media/construction-hero-poster.jpg" width="1280" height="720" alt="" fetchpriority="high" decoding="async" />
      </picture>
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-label">Academic review version</p>
        <h1 id="hero-heading">Know your materials. Track your equipment. Keep projects moving.</h1>
        <p class="hero-lead">
          Explore BuildTrack’s proposed approach to construction resource management—from inventory and equipment to
          deliveries and project reporting.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/product-demo/">Explore the Demo</a>
          <a class="button button-secondary" href={quotationHref}>Request a Quotation</a>
        </div>
      </div>
      <div class="hero-foot">
        <p class="media-credit">Background: stock construction footage, not a BuildTrack project.</p>
        <button type="button" class="video-toggle" data-video-toggle hidden>
          <svg class="icon-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path>
          </svg>
          <svg class="icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.5v13l10.5-6.5z"></path>
          </svg>
          <span data-video-label>Play background video</span>
        </button>
      </div>
    </div>
  </section>

  <section class="section showcase on-dark" aria-labelledby="showcase-heading">
    <div class="container showcase-grid">
      <div class="showcase-copy stack" data-reveal>
        <p class="eyebrow">Interactive Platform Demo</p>
        <h2 id="showcase-heading">See the proposed dashboard on any screen</h2>
        <p class="lead">
          These screens come from BuildTrack’s own Interactive Platform Demo, which runs in your browser on four fictional
          sample projects.
        </p>
        <p>The phone shows this website on a small screen. BuildTrack has no native mobile app.</p>
        <p><a class="button button-primary" href="/product-demo/">Explore the Demo</a></p>
      </div>
      <figure class="devices" data-device-entrance>
        <p class="sim-label">Simulated platform demo</p>
        <div class="device-stage">
          <div class="laptop">
            <div class="laptop-screen">
              <img
                src="/media/demo/demo-laptop.webp"
                width="1280"
                height="800"
                loading="lazy"
                decoding="async"
                alt="The Interactive Platform Demo on a laptop: a navy sidebar with the BuildTrack name, Back to website and its six sections, and a light Overview workspace with the project picker, Reset, a short introduction, a Simulated data label and low-stock, utilization and delivery figures."
              />
            </div>
            <div class="laptop-base"></div>
          </div>
          <div class="phone">
            <img
              src="/media/demo/demo-phone.webp"
              width="440"
              height="952"
              loading="lazy"
              decoding="async"
              alt="The demo in this website on a phone-sized screen: Back to website, a Sections button, project picker and Reset above a short introduction, the Simulated data label and Overview figures."
            />
          </div>
        </div>
        <figcaption>Screens captured from the Interactive Platform Demo. All projects and figures are fictional.</figcaption>
      </figure>
    </div>
  </section>

  <section class="capabilities" id="capabilities" aria-labelledby="capabilities-heading" data-cap>
    <div class="container">
      <header class="cap-head stack" data-reveal>
        <p class="eyebrow">Capabilities</p>
        <h2 id="capabilities-heading">Four things BuildTrack proposes to keep track of</h2>
        <p class="lead">Each screen comes from the simulated demo and opens that part of it.</p>
      </header>
    </div>
    <div class="cap-track" data-cap-track>
      <div class="cap-pin" data-cap-pin>
        <div class="container cap-layout" data-cap-layout>
          <div class="cap-text">
            <ol class="cap-list" data-cap-list>
              {
                capabilities.map((item, index) => (
                  <li class="cap-item" id={`capability-${item.id}`} data-cap-item>
                    <p class="cap-label">
                      <span class="cap-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span> {item.label}
                    </p>
                    <h3>{item.title}</h3>
                    <div
                      class="cap-detail"
                      role="group"
                      aria-label={`${item.label}: ${item.title}`}
                      data-cap-detail
                      data-for={`capability-${item.id}`}
                    >
                      <div class="cap-detail-inner">
                        <p>{item.text}</p>
                        <a class="text-link" href={item.href}>
                          {item.linkText} <Icon name="arrow" size={20} />
                        </a>
                      </div>
                    </div>
                    <figure
                      class="cap-figure"
                      data-cap-figure
                      data-for={`capability-${item.id}`}
                      data-cap-windows={revealWindows(drawings[item.id]!)}
                    >
                      <div class="cap-frame">
                        <img
                          src={item.image}
                          width="1088"
                          height="816"
                          loading="lazy"
                          decoding="async"
                          alt={item.alt}
                          style={revealMask(drawings[item.id]!)}
                        />
                        <svg class="cap-drawing" viewBox="0 0 1088 816" aria-hidden="true" focusable="false">
                          {drawings[item.id]!.map((band, k) => (
                            <g class="cap-band" style={`--r: var(--r${k}, 0)`}>
                              <g class="cap-ghost">
                                {band.strokes.map((d) => (
                                  <path d={d} />
                                ))}
                              </g>
                              <g class="cap-strokes">
                                {band.strokes.map((d, i) => (
                                  <path d={d} pathLength="1" style={`--s: ${pacing(drawings[item.id]!)[k]!.starts[i]!.toFixed(4)}`} />
                                ))}
                              </g>
                            </g>
                          ))}
                        </svg>
                      </div>
                      <figcaption>{item.caption}</figcaption>
                    </figure>
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="cap-stage" data-cap-stage hidden>
            <p class="sim-label">Simulated platform demo</p>
            <div class="cap-stage-frame" data-cap-stage-frame>
              <span class="cap-drawing-note">Illustrative layout drawing</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="container">
      <p class="cap-more">
        <a class="text-link" href="/solutions/">Explore all solutions and services <Icon name="arrow" size={20} /></a>
      </p>
    </div>
  </section>

  <section class="section workflow on-dark" aria-labelledby="workflow-heading">
    <div class="container">
      <header class="section-intro stack" data-reveal>
        <p class="eyebrow">How it would work</p>
        <h2 id="workflow-heading">Three steps from site to decision</h2>
        <p class="lead">
          The demo simulates the recording and reporting steps with fictional data. No QR, RFID or IoT hardware is
          connected; hardware integration is a proposed concept.
        </p>
      </header>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step" data-reveal style={`--i: ${index}`}>
              <a class="step-card" href={`/how-it-works/#${step.target}`}>
              <img
                class="step-media"
                src={step.image}
                width={step.width}
                height={step.height}
                loading="lazy"
                decoding="async"
                alt=""
              />
              <div class="step-copy"><h3>
                <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="visually-hidden">Step {index + 1}: </span>
                {step.title}
              </h3>
              <p>{step.text}</p>
              <span class="step-link-cue">Explore this step <Icon name="arrow" size={20} /></span></div>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="workflow-foot" data-reveal>
        <p class="media-credit">Photos: illustrative stock photography, not BuildTrack projects, customers or working hardware.</p>
        <p><a class="text-link" href="/how-it-works/">How it works <Icon name="arrow" size={20} /></a></p>
      </div>
    </div>
  </section>

  <section class="segments on-dark" aria-labelledby="segments-heading" data-audience-orbit>
    <div class="orbit-scroll" data-orbit-scroll>
      <div class="orbit-shell" data-orbit-shell>
        <header class="orbit-heading" data-orbit-heading>
          <p class="eyebrow">Who we serve</p>
          <h2 id="segments-heading">Built for the people behind every project.</h2>
        </header>
        <div class="orbit-art" data-orbit-art>
          <ul class="orbit-arrangement" data-orbit-arrangement>
            {customerSegments.map((segment, index) => (
              <li class="orbit-anchor" data-orbit-photo={segment.id} data-orbit-index={index}>
                <figure class="orbit-photo">
                  <div class="orbit-frame" data-audience-video-src={`/media/home/audience-${segment.id}.mp4`} style={`--media-aspect: ${audienceImages[segment.id].width} / ${audienceImages[segment.id].height}`}>
                    <img src={audienceImages[segment.id].src} width={audienceImages[segment.id].width} height={audienceImages[segment.id].height} loading="lazy" decoding="async" alt="" />
                    <p class="orbit-photo-error" hidden>Illustrative photo unavailable</p>
                  </div>
                  <figcaption><h3 data-audience-label tabindex="-1">{segment.label}</h3></figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
        <div class="orbit-foot" data-orbit-foot>
          <p class="media-credit">Illustrative stock footage, not BuildTrack customers, projects or working hardware.</p>
          <div class="audience-video-controls">
            <button type="button" class="audience-video-toggle" data-audience-video-toggle aria-describedby="audience-video-status" hidden>Play videos</button>
            <span class="visually-hidden" id="audience-video-status" data-audience-video-status role="status"></span>
          </div>
          <a class="text-link" href="/solutions/#segments">Explore audience needs <Icon name="arrow" size={20} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section pricing-preview" aria-labelledby="pricing-heading">
    <div class="container">
      <header class="section-intro stack" data-reveal>
        <p class="eyebrow">Pricing</p>
        <h2 id="pricing-heading">Three proposed packages</h2>
        <p class="lead">{pricingNote}</p>
      </header>
      <ul class="price-list" data-reveal>
        {
          plans.map((plan) => (
            <li>
              <p class="tier">{tierLabels[plan.tier]}</p>
              <h3>{plan.name}</h3>
              <p class="price">
                {priceLabel(plan)}
                {plan.amountPhp !== null && <span class="basis">{priceBasis}</span>}
              </p>
              <p class="positioning">{plan.positioning}</p>
              <a class="text-link" href={contactHref({ type: 'service', plan: plan.id })}>
                Avail {plan.name} <Icon name="arrow" size={20} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="after"><a class="text-link" href="/pricing/">See pricing details <Icon name="arrow" size={20} /></a></p>
    </div>
  </section>

  <section class="closing on-dark" aria-labelledby="closing-heading">
    <picture class="closing-media">
      <img src="/media/construction-wide-1280.webp" width="1280" height="853" alt="" loading="lazy" decoding="async" />
    </picture>
    <div class="container closing-inner stack" data-reveal>
      <h2 id="closing-heading">Ready to see BuildTrack?</h2>
      <p class="lead">Request a walkthrough of the proposed platform or a quotation for your project.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={primaryCta.href}>{primaryCta.label}</a>
        <a class="button button-secondary" href={quotationHref}>Request a Quotation</a>
      </div>
      <p class="media-credit">Background: stock construction photo, not a BuildTrack project.</p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initHeroVideo } from '../scripts/hero-video.ts';
  import { initReveal } from '../scripts/reveal.ts';
  import { initCapabilityStage } from '../scripts/capability-stage.ts';
  import { initAudienceSequence } from '../scripts/audience-sequence.ts';
  import { initDeviceEntrance } from '../scripts/device-entrance.ts';
  initReveal();
  initHeroVideo();
  initCapabilityStage();
