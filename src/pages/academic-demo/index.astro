---
// /academic-demo/: the website's quotation request page in academic-demo form (src/lib/academic-demo.ts).
// Laid out like the real quotation request page (src/routes/quotation-request.astro): the same navy
// banner, "Your project" form and request-received panel. Instead of personal details it uses a
// FICTIONAL sample customer: there are no text, email or phone inputs, and nothing typed is collected.
// Service and plan come from Home/Pricing/Contact (?service=, ?plan=). The request is kept only in
// this browser; no server, email service or Formspree is contacted. The real workflow is separate and off.
import Icon from '../../components/site/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { demoIdentities, demoPlans } from '../../lib/academic-demo.ts';
import { capabilityServices, supportingServices } from '../../config/services.ts';
import { planLabel, plans } from '../../config/pricing.ts';
import { pageMeta } from '../../config/site.ts';

const meta = pageMeta('/academic-demo/');
const first = demoIdentities[0];
const samples = [
  ['name', 'Full name', first.name],
  ['email', 'Work email', first.email],
  ['organization', 'Organization', first.organization],
  ['organizationType', 'Organization type', first.organizationType],
  ['projectNeed', 'Project need', first.projectNeed],
] as const;
const demoPlanIds = new Set<string>(demoPlans.map((plan) => plan.id));
---

<BaseLayout title={meta.title} description={meta.description}>
  <section class="intro on-dark" aria-labelledby="quotation-heading">
    <div class="container intro-inner">
      <p class="eyebrow">Contact · Quotation · Academic demo</p>
      <h1 id="quotation-heading">Request a quotation</h1>
      <p class="lead">
        Tell BuildTrack about your project. BuildTrack reviews every request; a quotation link is sent only after BuildTrack
        approves it. A request is not a payment, booking or subscription.
      </p>
      <p class="notice-bar">
        <strong>Academic demo.</strong> You play a fictional sample customer. The request stays in this browser: nothing is
        sent to BuildTrack, emailed or stored anywhere else.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container form-wrap" data-demo-request>
      <h2 class="form-heading" data-form-heading>Your project</h2>
      <form class="inquiry-form" data-demo-form novalidate>
        <p class="muted">Fields marked (required) must be completed.</p>

        <div class="field">
          <label for="demo-service">Service of interest <span class="field-need">(optional)</span></label>
          <select id="demo-service" name="service">
            <option value="">Not sure yet</option>
            <optgroup label="Platform capabilities">
              {capabilityServices.map((service) => <option value={service.id}>{service.name}</option>)}
            </optgroup>
            <optgroup label="Supporting services">
              {supportingServices.map((service) => <option value={service.id}>{service.name}</option>)}
            </optgroup>
          </select>
        </div>

        <div class="field">
          <label for="demo-plan">Plan of interest <span class="field-need">(optional)</span></label>
          <select id="demo-plan" name="plan">
            <option value="">Not sure yet</option>
            {plans.filter((plan) => demoPlanIds.has(plan.id)).map((plan) => <option value={plan.id}>{planLabel(plan)}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="demo-identity">Sample customer <span class="field-need">(required; fictional)</span></label>
          <p class="field-hint" id="demo-identity-hint">
            The demo never asks for your own details. Choose one of these made-up customers; their details fill in below.
          </p>
          <select id="demo-identity" name="identity" aria-describedby="demo-identity-hint">
            {demoIdentities.map((identity) => <option value={identity.id}>{identity.name}, {identity.organization}</option>)}
          </select>
        </div>

        <div class="sample" aria-live="polite">
          {
            samples.map(([key, label, value]) => (
              <div class="field">
                <span class="sample-label">
                  {label} <span class="field-need">(sample, fictional)</span>
                </span>
                <p class="sample-value" data-sample={key}>
                  {value}
                </p>
              </div>
            ))
          }
        </div>

        <div class="field field-check">
          <label for="demo-ack" class="check-label">
            <input type="checkbox" id="demo-ack" name="ack" aria-describedby="demo-ack-error" />
            <span>
              I understand this is an academic demo: the customer is fictional, the request stays in this browser, and no
              request, email or payment is real. <span class="field-need">(required)</span>
            </span>
          </label>
          <p class="field-error" id="demo-ack-error" hidden>
            <Icon name="alert" size={18} /><span>Tick this box to send the demo request.</span>
          </p>
        </div>

        <button type="submit" class="button button-primary submit">Send demo quotation request</button>
      </form>

      <div class="confirmation" data-demo-confirmation hidden>
        <h2 tabindex="-1" data-demo-confirmation-heading>Quotation request received (academic demo)</h2>
        <p>Your demo reference is <strong data-demo-reference></strong>.</p>
        <p>
          In the real service, BuildTrack's owner, Sunny, reviews the request and emails a private quotation link once it is
          approved. In this demo, open the demo owner dashboard to play that part. Nothing has been sent.
        </p>
        <dl class="summary">
          <div><dt>Request type</dt><dd>Quotation (academic demo)</dd></div>
          <div><dt>Service of interest</dt><dd data-confirm-service></dd></div>
          <div><dt>Plan of interest</dt><dd data-confirm-plan></dd></div>
          <div><dt>Sample customer</dt><dd data-confirm-customer></dd></div>
        </dl>
        <p><strong>This is a demo request only. No payment, booking or subscription has been made.</strong></p>
        <div class="actions">
          <a class="button button-primary" href="/academic-demo/owner/" target="_blank" rel="noopener">Open demo owner dashboard</a>
          <button type="button" class="button button-secondary" data-demo-again>Send another demo request</button>
        </div>
      </div>

      <p class="other-requests">
        Want to send a real demo, quotation or service request instead? Use the <a class="text-link" href="/contact/">Contact page</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { startDemoRequestPage } from '../../scripts/academic-demo/request.ts';
  startDemoRequestPage();
</script>

<style>
  /* Banner and form column match the real quotation request page (src/routes/quotation-request.astro). */
  .intro {
    padding-block: var(--space-8);
    background-color: var(--color-navy);
    background-image: var(--blueprint-grid), radial-gradient(60rem 30rem at 85% 10%, rgb(32 164 243 / 0.18), transparent 60%);
    background-size: var(--blueprint-grid-size), auto;
    color: #fff;
  }

  .intro-inner > * + * {
    margin-top: var(--space-4);
  }

  .intro .lead {
    max-width: 46rem;
    color: var(--color-blue-pale);
  }

  .notice-bar {
    max-width: 46rem;
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-yellow);
    background: rgb(255 255 255 / 0.08);
    color: #fff;
  }

  .form-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    max-width: 44rem;
  }

  .form-heading {
    font-size: var(--text-2xl);
  }

  /* Field styles: the same values as the inquiry form (src/components/form/InquiryForm.astro). */
  .inquiry-form,
  .sample {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .inquiry-form > *,
  .field {
    min-width: 0;
  }

  .field {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    max-width: 36rem;
    padding: 0 0 0 var(--space-3);
    border-left: 3px solid transparent;
  }

  .field.has-error {
    border-left-color: var(--color-danger);
  }

  .field > label,
  .sample-label {
    font-weight: 600;
  }

  .field-need {
    font-weight: 400;
    color: var(--color-muted);
  }

  .field-hint {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .field select {
    width: 100%;
    min-width: 0;
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
  }

  /* Sample details look like filled fields but are plain text: nothing here can be typed in. */
  .sample-value {
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-blue-pale);
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .field select:focus-visible,
  .button:focus-visible,
  .check-label input:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .field-error {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    color: var(--color-danger);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .field-error :global(.icon) {
    flex: none;
    margin-top: 0.1em;
  }

  .check-label {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    cursor: pointer;
  }

  .check-label input {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.05em;
    accent-color: var(--color-blue);
  }

  .submit {
    justify-self: start;
  }

  /* Request received: the inquiry form's confirmation panel. */
  .confirmation {
    padding: var(--space-5);
    border-left: 4px solid var(--color-success);
    border-radius: var(--radius-md);
    background: var(--color-success-bg);
  }

  .confirmation > * + * {
    margin-top: var(--space-3);
  }

  .confirmation h2 {
    font-size: var(--text-xl);
  }

  .confirmation h2:focus {
    outline: none;
  }

  .summary {
    display: grid;
    gap: var(--space-2);
  }

  .summary div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
  }

  .summary dt {
    font-weight: 600;
  }

  .summary dt::after {
    content: ':';
  }

  .summary dd {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
