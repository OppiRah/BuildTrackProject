---
import PageHeader from '../components/site/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | BuildTrack" description="The page you were looking for does not exist." noindex>
  <PageHeader title="Page not found" lead="The page you were looking for does not exist or has moved.">
    <p class="actions">
      <a class="button button-primary" href="/">Go to Home</a>
      <a href="/contact/">Contact BuildTrack</a>
    </p>
  </PageHeader>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }
</style>
