---
import Icon from '../components/site/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../config/site.ts';

// Main destinations other than Home and Contact, which are the two actions above them.
const destinations = pages.filter((page) => page.path !== '/' && page.path !== '/contact/');
---

<BaseLayout title="Page not found | BuildTrack" description="The page you were looking for does not exist." noindex>
  <section class="not-found on-dark" aria-labelledby="not-found-heading">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1 id="not-found-heading">Page not found</h1>
      <p class="lead">The page you were looking for does not exist or has moved.</p>
      <p class="actions">
        <a class="button button-primary" href="/">Go to Home</a>
        <a class="text-link" href="/contact/">Contact BuildTrack <Icon name="arrow" size={20} /></a>
      </p>
      <nav class="elsewhere" aria-labelledby="elsewhere-heading">
        <h2 id="elsewhere-heading">Or go to</h2>
        <ul>
          {
            destinations.map((page) => (
              <li>
                <a href={page.path}>{page.navLabel}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  /* Fill the space between header and footer on this page only. */
  :global(main:has(.not-found)) {
    display: flex;
    flex-direction: column;
  }

  .not-found {
    flex: 1;
    padding-block: var(--space-10);
    background-color: var(--color-navy);
    background-image: var(--blueprint-grid);
    background-size: var(--blueprint-grid-size);
    color: #fff;
  }

  @media (min-width: 64rem) {
    .not-found {
      padding-block: var(--space-12);
    }
  }

  .not-found .container > * + * {
    margin-top: var(--space-5);
  }

  .not-found h1 {
    max-width: 100%;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4rem);
    letter-spacing: -0.025em;
  }

  .lead {
    color: var(--color-blue-pale);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }

  .elsewhere {
    max-width: 40rem;
    padding-top: var(--space-6);
    border-top: 1px solid rgb(125 211 252 / 0.3);
  }

  .elsewhere h2 {
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-yellow);
  }

  .elsewhere ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .elsewhere a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-weight: 600;
  }
</style>
