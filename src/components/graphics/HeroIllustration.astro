---
// Original BuildTrack illustration (project-owned artwork, see docs/UX_BRAND.md image log).
// A building frame, material stacks and equipment with tags feeding a sample dashboard card.
---

<svg
  class="hero-illustration"
  viewBox="0 0 480 380"
  role="img"
  aria-labelledby="hero-illustration-title"
>
  <title id="hero-illustration-title">
    Illustration: tagged materials and equipment on a construction site sending updates to a sample dashboard
  </title>
  <rect x="0" y="0" width="480" height="380" rx="16" fill="#0b2742"></rect>
  <g stroke="#20a4f3" stroke-opacity="0.18" stroke-width="1">
    <path d="M0 60h480M0 120h480M0 180h480M0 240h480M0 300h480M60 0v380M120 0v380M180 0v380M240 0v380M300 0v380M360 0v380M420 0v380"></path>
  </g>

  <!-- Building frame -->
  <g stroke="#eaf6ff" stroke-width="4" stroke-linecap="square" fill="none">
    <path d="M60 320V150h140v170M60 207h140M60 264h140M107 150v170M153 150v170"></path>
  </g>
  <!-- Crane -->
  <g stroke="#ffd43b" stroke-width="4" fill="none" stroke-linecap="round">
    <path d="M230 320V70M230 70h150M230 70l-30 25M230 70l-30 0M350 70v60"></path>
    <path d="M230 110l20-40M230 150l20-40M230 190l20-40M230 230l20-40M230 270l20-40" stroke-width="2"></path>
  </g>
  <rect x="338" y="130" width="24" height="18" fill="#ffd43b"></rect>

  <!-- Material stacks -->
  <g>
    <rect x="270" y="286" width="44" height="34" rx="3" fill="#1268b3"></rect>
    <rect x="318" y="286" width="44" height="34" rx="3" fill="#1268b3"></rect>
    <rect x="294" y="252" width="44" height="34" rx="3" fill="#20a4f3"></rect>
  </g>
  <!-- QR tag on stack -->
  <g transform="translate(305 262)">
    <rect width="22" height="22" rx="2" fill="#ffffff"></rect>
    <path d="M3 3h6v6H3zM13 3h6v6h-6zM3 13h6v6H3zM13 13h3v3h-3zM17 17h2v2h-2z" fill="#071a2b"></path>
  </g>

  <!-- Excavator -->
  <g transform="translate(380 262)">
    <rect x="0" y="34" width="70" height="16" rx="8" fill="#475569"></rect>
    <rect x="8" y="10" width="40" height="26" rx="4" fill="#ffd43b"></rect>
    <rect x="30" y="14" width="14" height="12" rx="2" fill="#0b2742"></rect>
    <path d="M48 18l26-30 14 22" stroke="#ffd43b" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle cx="14" cy="42" r="5" fill="#0b2742"></circle>
    <circle cx="56" cy="42" r="5" fill="#0b2742"></circle>
  </g>
  <!-- RFID tag on excavator -->
  <rect x="392" y="276" width="16" height="10" rx="2" fill="#ffffff"></rect>

  <!-- Ground -->
  <path d="M30 320h420" stroke="#eaf6ff" stroke-opacity="0.5" stroke-width="2"></path>

  <!-- Signal arcs -->
  <g stroke="#20a4f3" stroke-width="3" fill="none" stroke-linecap="round">
    <path d="M316 238a14 14 0 0 1 0-20"></path>
    <path d="M308 244a26 26 0 0 1 0-32"></path>
    <path d="M400 262a14 14 0 0 1 0-20"></path>
  </g>

  <!-- Sample dashboard card -->
  <g transform="translate(40 30)">
    <rect width="170" height="96" rx="10" fill="#ffffff"></rect>
    <rect x="14" y="14" width="70" height="8" rx="4" fill="#0b2742"></rect>
    <rect x="14" y="30" width="44" height="6" rx="3" fill="#94a3b8"></rect>
    <rect x="14" y="76" width="18" height="8" fill="#1268b3"></rect>
    <rect x="38" y="62" width="18" height="22" fill="#1268b3"></rect>
    <rect x="62" y="52" width="18" height="32" fill="#1268b3"></rect>
    <rect x="86" y="68" width="18" height="16" fill="#ffd43b"></rect>
    <rect x="110" y="46" width="18" height="38" fill="#1268b3"></rect>
    <rect x="134" y="58" width="18" height="26" fill="#1268b3"></rect>
  </g>
</svg>

<style>
  .hero-illustration {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }
</style>
