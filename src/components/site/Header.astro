---
import { pages, primaryCta } from '../../config/site.ts';
import Wordmark from './Wordmark.astro';

interface Props {
  /** False keeps the header in the page flow (scrolls away) on every screen size. */
  sticky?: boolean;
}

const { sticky = true } = Astro.props;

const current = Astro.url.pathname;
---

<header class:list={['site-header on-dark', { 'is-static': !sticky }]} data-site-header>
  <div class="container header-bar">
    <Wordmark />
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden data-menu-toggle>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path class="icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="icon-close" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
      <span>Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="nav-list">
        {
          pages.map((page) => (
            <li>
              <a href={page.path} aria-current={page.path === current ? 'page' : undefined}>
                {page.navLabel}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
      <a class="button button-primary nav-cta" href={primaryCta.href}>{primaryCta.label}</a>
    </nav>
  </div>
</header>

<script>
  import { initNav } from '../../scripts/nav.ts';
  initNav();
</script>

<style>
  /* Not sticky in the no-JS mobile fallback: the wrapped link list is tall and
     would cover in-page targets such as the skip-link destination. */
  .site-header {
    position: relative;
    z-index: 50;
    background-color: var(--color-navy);
    background-image: var(--blueprint-grid-quiet);
    background-size: var(--blueprint-grid-size);
    border-bottom: 1px solid rgb(234 246 255 / 0.16);
  }

  .header-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    /* Minimum spacing only (space-between spreads the items); kept small so the tiled
       logo and the Menu button share one row on 320 px screens. */
    gap: var(--space-2) var(--space-3);
    min-height: var(--header-height);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 2px solid rgb(234 246 255 / 0.7);
    border-radius: var(--radius-md);
    background: transparent;
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .menu-toggle[hidden] {
    display: none;
  }

  .menu-toggle .icon-close,
  .menu-toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-close {
    display: inline;
  }

  /* Mobile/no-JS default: links wrap visibly below the wordmark. */
  .site-nav {
    flex-basis: 100%;
    padding-bottom: var(--space-3);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: #fff;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-list a:hover,
  .nav-list a:focus-visible {
    color: var(--color-yellow);
  }

  .nav-list a:hover {
    text-decoration: underline;
  }

  .nav-list a[aria-current='page'] {
    font-weight: 600;
    box-shadow: inset 0 -3px 0 var(--color-yellow);
  }

  .nav-cta {
    margin-top: var(--space-2);
  }

  /* With JavaScript below the desktop breakpoint: a disclosure panel. */
  .site-header.js-nav {
    position: sticky;
    top: 0;
  }

  .js-nav .site-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100vh - var(--header-rendered, var(--header-height)));
    max-height: calc(100dvh - var(--header-rendered, var(--header-height)));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-2) var(--gutter) var(--space-5);
    background-color: var(--color-navy);
    background-image: var(--blueprint-grid-quiet);
    background-size: var(--blueprint-grid-size);
    border-bottom: 1px solid rgb(234 246 255 / 0.16);
    box-shadow: var(--shadow-md);
  }

  .js-nav .site-nav[data-open] {
    display: block;
  }

  .js-nav .nav-list {
    flex-direction: column;
  }

  .js-nav .nav-list a {
    display: flex;
    min-height: 3rem;
    border-bottom: 1px solid rgb(234 246 255 / 0.16);
  }

  .js-nav .nav-list a[aria-current='page'] {
    box-shadow: inset 3px 0 0 var(--color-yellow);
    padding-left: var(--space-3);
  }

  .js-nav .nav-cta {
    width: 100%;
    margin-top: var(--space-4);
  }

  /* Desktop only, with JavaScript (nav.ts): one yellow indicator that sits under the current page
     and moves under a hovered or keyboard-focused link. */
  .nav-indicator {
    display: none;
  }

  /* Desktop header breakpoint: set by the header fit check (docs/UX_BRAND.md §3.1).
     Must match DESKTOP_NAV_QUERY in src/scripts/nav.ts. */
  @media (min-width: 75rem) {
    .site-header {
      position: sticky;
      top: 0;
    }

    .header-bar {
      flex-wrap: nowrap;
    }

    .menu-toggle {
      display: none;
    }

    .site-nav,
    .js-nav .site-nav {
      display: flex;
      position: relative;
      flex-basis: auto;
      align-items: center;
      gap: var(--space-5);
      max-height: none;
      overflow: visible;
      padding: 0;
      border: 0;
      box-shadow: none;
    }

    /* Modest padding widens each link's target; the smaller gap keeps the text spacing (and the
       header fit) unchanged. */
    .nav-list,
    .js-nav .nav-list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: var(--space-2);
    }

    .nav-list a,
    .js-nav .nav-list a {
      min-height: var(--header-height);
      padding-inline: var(--space-2);
      border-bottom: 0;
    }

    .js-nav .nav-list a[aria-current='page'] {
      box-shadow: inset 0 -3px 0 var(--color-yellow);
      padding-left: var(--space-2);
    }

    /* The moving indicator replaces the static marker and the hover underline once placed. It is
       100 px wide, moved and scaled to the target's text by a transform (no layout). */
    .has-indicator .nav-list a[aria-current='page'] {
      box-shadow: none;
    }

    .has-indicator .nav-list a:hover {
      text-decoration: none;
    }

    .has-indicator .nav-indicator {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100px;
      height: 3px;
      background: var(--color-yellow);
      transform-origin: 0 0;
      transform: translate(var(--x, 0), var(--y, 0)) scaleX(var(--w, 0));
      opacity: var(--o, 0);
      pointer-events: none;
    }

    .has-indicator.is-indicator-ready .nav-indicator {
      transition:
        transform 250ms ease,
        opacity 150ms ease;
    }

    .nav-cta,
    .js-nav .nav-cta {
      width: auto;
      margin-top: 0;
      white-space: nowrap;
    }
  }


  /* Application-style pages (BaseLayout stickyHeader={false}): never sticky. */
  .site-header.is-static,
  .site-header.is-static.js-nav {
    position: relative;
  }
</style>
