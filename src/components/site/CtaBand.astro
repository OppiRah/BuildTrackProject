---
interface Link {
  label: string;
  href: string;
}

interface Props {
  title: string;
  lead?: string;
  primary: Link;
  secondary?: Link;
}

const { title, lead, primary, secondary } = Astro.props;
---

<section class="cta-band on-dark">
  <div class="container">
    <h2>{title}</h2>
    {lead && <p>{lead}</p>}
    <div class="actions">
      <a class="button button-primary" href={primary.href}>{primary.label}</a>
      {secondary && <a class="button button-secondary" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--space-10);
    background: linear-gradient(135deg, var(--color-ink), var(--color-navy));
    color: #fff;
  }

  p {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-blue-pale);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
