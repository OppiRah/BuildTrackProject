---
interface Link {
  label: string;
  href: string;
}

interface Props {
  title: string;
  lead?: string;
  primary: Link;
  secondary?: Link;
}

const { title, lead, primary, secondary } = Astro.props;
---

<section class="cta-band on-dark">
  <div class="container">
    <h2>{title}</h2>
    {lead && <p>{lead}</p>}
    <div class="actions">
      <a class="button button-primary" href={primary.href}>{primary.label}</a>
      {secondary && <a class="button button-secondary" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--space-10);
    background-image: var(--blueprint-grid), linear-gradient(135deg, var(--color-ink), var(--color-navy));
    background-size: var(--blueprint-grid-size), auto;
    color: #fff;
  }

  p {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-blue-pale);
  }

  /* Narrow relative to the text size (em follows the browser default): a smaller heading keeps
     whole words such as "Questions" and "BuildTrack?" on one line instead of splitting them. */
  @media (max-width: 22em) {
    h2 {
      font-size: var(--text-xl);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
