---
import Icon from './Icon.astro';
import type { IconName } from './icons.ts';

interface Props {
  detailed?: boolean;
}

const { detailed = false } = Astro.props;

const steps: { icon: IconName; title: string; summary: string; who: string; demo: string }[] = [
  {
    icon: 'tag',
    title: 'Tag resources',
    summary: 'Materials, equipment and storage areas get QR labels, RFID tags or IoT devices.',
    who: 'Site team, with hardware set up during implementation.',
    demo: 'The demo shows each item with a QR or RFID tag type.',
  },
  {
    icon: 'scan',
    title: 'Capture events',
    summary: 'Scans at gates, stockpiles and equipment record arrivals, use and movement; devices report their status.',
    who: 'Storekeepers, site engineers and equipment operators.',
    demo: 'The demo lists fictional scan and gate-read events.',
  },
  {
    icon: 'cloud',
    title: 'Proposed cloud platform',
    summary: 'Records from every site are brought together in one place for each project.',
    who: 'Handled by the platform; no manual consolidation.',
    demo: 'The demo uses fixed sample data stored in the page.',
  },
  {
    icon: 'decision',
    title: 'Dashboards and decisions',
    summary: 'Dashboards and alerts show low stock, idle equipment and late deliveries so teams can act early.',
    who: 'Project managers, engineers and management.',
    demo: 'The demo shows these dashboards with sample figures.',
  },
];
---

<ol class:list={['steps', { detailed }]}>
  {
    steps.map((step, index) => (
      <li class="step">
        <span class="step-number" aria-hidden="true">
          {index + 1}
        </span>
        <Icon name={step.icon} class="step-icon" />
        <h3>
          <span class="visually-hidden">Step {index + 1}: </span>
          {step.title}
        </h3>
        <p>{step.summary}</p>
        {detailed && (
          <dl>
            <dt>Who is involved</dt>
            <dd>{step.who}</dd>
            <dt>In the demo</dt>
            <dd>{step.demo}</dd>
          </dl>
        )}
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .step {
    position: relative;
    min-width: 0;
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-ink);
  }

  .step-number {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: var(--space-3);
    border-radius: 50%;
    background: var(--color-yellow);
    color: var(--color-ink);
    font-weight: 700;
  }

  .step-icon {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    color: var(--color-blue);
  }

  h3 {
    font-size: var(--text-lg);
  }

  p {
    margin-top: var(--space-2);
    color: var(--color-muted);
  }

  dl {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0 0 var(--space-2);
    color: var(--color-muted);
  }
</style>
