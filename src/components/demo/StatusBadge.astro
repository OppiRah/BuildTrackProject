---
import type { Tone } from '../../data/demo/labels.ts';

interface Props {
  tone: Tone;
  label: string;
}

const { tone, label } = Astro.props;
// Icon shape differs per tone so status never relies on color alone.
const icon: Record<Tone, string> = {
  ok: 'M5 12l4 4 10-10',
  warning: 'M12 4l9 16H3zM12 10v4M12 17h.01',
  danger: 'M6 6l12 12M18 6L6 18',
  info: 'M12 21a9 9 0 100-18 9 9 0 000 18zM12 7v5l3 2',
};
---

<span class={`status status-${tone}`}>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={icon[tone]}></path></svg>
  {label}
</span>
