---
// Academic payment demonstration (/payment-demo/): a simulated walkthrough
// (src/lib/payment-walkthrough.ts), never a payment. Fictional quotation → simulated acceptance →
// card or bank choice → explicitly simulated outcome. No card, CVV or banking fields, no account
// details or banking instructions, no QR codes, uploads or payment records; nothing is collected,
// charged, sent or verified, and no provider is contacted. Independent of the inquiry form. The
// optional provider sandbox link (src/config/payment-sandbox.ts) is off by default.
import { providerSandbox } from '../../config/payment-sandbox.ts';
import { formatPhp, plans } from '../../config/pricing.ts';
import { sandboxLink } from '../../lib/payment-sandbox.ts';
import { methodLabels, outcomeMessages, stepLabels } from '../../lib/payment-walkthrough.ts';

const plan = plans.find((p) => p.id === 'professional')!;
// The proposed academic price, used only as an illustrative amount.
const amount = plan.amountPhp === null ? 'an illustrative amount' : formatPhp(plan.amountPhp);
const sandbox = sandboxLink(providerSandbox);
---

<div class="pay" data-pay>
  <p class="pay-notice" role="note">
    <strong>Academic payment demonstration — no real charge.</strong>
    Every step below is simulated: nothing is collected, charged, sent or verified, and no payment provider is
    contacted.
  </p>

  <ol class="pay-progress" aria-label="Walkthrough steps" data-pay-controls hidden>
    {
      Object.entries(stepLabels).map(([step, label]) => (
        <li data-pay-progress-step={step}>{label}</li>
      ))
    }
  </ol>

  <p class="visually-hidden" role="status" aria-live="polite" data-pay-status></p>

  <section class="pay-step" data-pay-step="quotation" aria-labelledby="pay-quotation-heading">
    <h2 id="pay-quotation-heading" tabindex="-1">Fictional quotation</h2>
    <dl class="pay-quote">
      <div><dt>Reference</dt><dd>Q-DEMO-0001 (fictional)</dd></div>
      <div><dt>Client</dt><dd>Sample Client Builders (fictional)</dd></div>
      <div><dt>Item</dt><dd>{plan.name} plan, first month (proposed academic pricing)</dd></div>
      <div><dt>Amount</dt><dd>{amount} (illustrative only; nothing will be charged)</dd></div>
    </dl>
    <div class="pay-actions" data-pay-controls hidden>
      <button type="button" class="button button-primary" data-pay-action="accept">Accept quotation (simulated)</button>
      <button type="button" class="button button-secondary" data-pay-action="decline">Decline</button>
    </div>
    <p class="pay-nojs" data-pay-nojs>The walkthrough's steps need JavaScript. Nothing on this page ever takes a payment.</p>
  </section>

  <section class="pay-step" data-pay-step="declined" aria-labelledby="pay-declined-heading" hidden>
    <h2 id="pay-declined-heading" tabindex="-1">Quotation declined (simulated)</h2>
    <p>Nothing was sent. In a real flow BuildTrack would simply not issue a payment request.</p>
    <div class="pay-actions"><button type="button" class="button button-secondary" data-pay-action="restart">Start again</button></div>
  </section>

  <section class="pay-step" data-pay-step="method" aria-labelledby="pay-method-heading" hidden>
    <h2 id="pay-method-heading" tabindex="-1">Choose a payment method (simulated)</h2>
    <p>
      Card details would be entered only on a payment provider's own secure page, never on BuildTrack, so this
      demonstration asks for none. It gives no bank details or transfer instructions.
    </p>
    <div class="pay-actions">
      <button type="button" class="button button-primary" data-pay-action="choose" data-method="card">{methodLabels.card}</button>
      <button type="button" class="button button-primary" data-pay-action="choose" data-method="bank">{methodLabels.bank}</button>
      <button type="button" class="button button-secondary" data-pay-action="restart">Start over</button>
    </div>
  </section>

  <section class="pay-step" data-pay-step="confirm" aria-labelledby="pay-confirm-heading" hidden>
    <h2 id="pay-confirm-heading" tabindex="-1">Simulated payment</h2>
    <p>
      <span data-pay-method>{methodLabels.card}</span> for {amount}. In a real flow the provider would show its own page
      and report the result. Here you choose a simulated result to see how each case is handled.
    </p>
    <div class="pay-actions">
      <button type="button" class="button button-primary" data-pay-action="outcome" data-outcome="success">Simulate success</button>
      <button type="button" class="button button-secondary" data-pay-action="outcome" data-outcome="failure">Simulate failure</button>
      <button type="button" class="button button-secondary" data-pay-action="outcome" data-outcome="cancelled">Simulate cancellation</button>
      <button type="button" class="button button-secondary" data-pay-action="back">Back</button>
    </div>
  </section>

  <section class="pay-step" data-pay-step="result" aria-labelledby="pay-result-heading" hidden>
    <h2 id="pay-result-heading" tabindex="-1" data-pay-result-title>{outcomeMessages.success.title}</h2>
    <p data-pay-result-text>{outcomeMessages.success.text}</p>
    <p class="pay-record">
      <strong>Not a payment record.</strong> A real payment's status would come only from the provider's own records, never
      from this page, a return link, a screenshot or a customer's message.
    </p>
    <div class="pay-actions"><button type="button" class="button button-secondary" data-pay-action="restart">Start again</button></div>
  </section>

  <aside class="pay-sandbox" aria-labelledby="pay-sandbox-heading">
    <h2 id="pay-sandbox-heading">Provider sandbox</h2>
    {
      sandbox ? (
        <>
          <p>
            A test checkout hosted by {sandbox.providerName}, in its test mode: no real charge. Its result is not proof of
            payment; status is checked in the provider's own test dashboard.
          </p>
          <p>
            <a class="text-link" href={sandbox.url} rel="noopener noreferrer" target="_blank">
              Open the {sandbox.providerName} test checkout (opens a new tab)
            </a>
          </p>
        </>
      ) : (
        <>
          <p class="pay-sandbox-status" data-sandbox-status>
            <strong>Provider sandbox not connected.</strong>
          </p>
          <p>
            A provider-hosted test checkout can be linked here only after the owner verifies one in their own provider
            account. Until then nothing on this page connects to a payment provider. Account eligibility and bank
            channels are not confirmed, and live payments are outside this academic prototype.
          </p>
        </>
      )
    }
  </aside>
</div>

<script>
  import { initPaymentDemo } from '../../scripts/payment-demo.ts';
  initPaymentDemo();
</script>

<style>
  .pay {
    display: grid;
    gap: var(--space-5);
    max-width: 52rem;
  }

  .pay > * {
    min-width: 0;
  }

  .pay-notice {
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-yellow);
    background: var(--color-navy);
    color: var(--color-blue-pale);
  }

  .pay-notice strong {
    display: block;
    color: #fff;
  }

  .pay-progress {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .pay-progress li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
  }

  .pay-progress li:global(.is-done) {
    color: var(--color-ink);
  }

  .pay-progress li[aria-current='step'] {
    border-color: var(--color-navy);
    background: var(--color-navy);
    color: #fff;
    font-weight: 700;
  }

  .pay-step,
  .pay-sandbox {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .pay h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-xl);
  }

  .pay-step h2 {
    scroll-margin-block: var(--space-6);
  }

  .pay-step h2:focus {
    outline: none;
  }

  .pay-step h2:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  /* Label beside value; the value moves under its label when there is no room. */
  .pay-quote {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .pay-quote div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }

  .pay-quote dt {
    flex: 0 0 7rem;
    max-width: 100%;
    font-weight: 600;
  }

  .pay-quote dd {
    flex: 1 1 12rem;
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .pay-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .pay-nojs,
  .pay-record {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .pay-record strong {
    color: var(--color-ink);
  }

  .pay-sandbox {
    border: 2px dashed var(--color-border-strong);
    background: transparent;
    font-size: var(--text-sm);
  }

  .pay-sandbox p + p {
    margin-top: var(--space-2);
  }
</style>
